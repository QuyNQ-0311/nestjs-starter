generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model AuthServicePlatform {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")

  users         AuthServiceUser[]
  roles         AuthServiceRole[]
  refreshTokens AuthServiceRefreshToken[]

  @@map("auth_service_platforms")
}

model AuthServiceUser {
  id           Int       @id @default(autoincrement())
  platformId   Int       @map("platform_id")
  email        String
  passwordHash String    @map("password")
  phone        String?
  avatar       String?
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  platform      AuthServicePlatform       @relation(fields: [platformId], references: [id])
  refreshTokens AuthServiceRefreshToken[]
  userRoles     AuthServiceUserRole[]

  @@unique([platformId, email])
  @@index([platformId])
  @@map("auth_service_users")
}

model AuthServiceRefreshToken {
  id         Int      @id @default(autoincrement())
  platformId Int      @map("platform_id")
  value      String // sha256 hash of the refresh token
  userId     Int      @map("user_id")
  isActive   Boolean  @default(true) @map("is_active")
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  user     AuthServiceUser     @relation(fields: [userId], references: [id])
  platform AuthServicePlatform @relation(fields: [platformId], references: [id])

  @@unique([value])
  @@index([userId])
  @@index([platformId])
  @@map("auth_service_refresh_tokens")
}

model AuthServiceRole {
  id         Int       @id @default(autoincrement())
  platformId Int       @map("platform_id")
  code       String
  name       String
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  platform        AuthServicePlatform         @relation(fields: [platformId], references: [id])
  userRoles       AuthServiceUserRole[]
  rolePermissions AuthServiceRolePermission[]

  @@unique([platformId, code])
  @@index([platformId])
  @@map("auth_service_roles")
}

model AuthServicePermission {
  id          Int       @id @default(autoincrement())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  rolePermissions AuthServiceRolePermission[]

  @@map("auth_service_permissions")
}

model AuthServiceUserRole {
  userId Int @map("user_id")
  roleId Int @map("role_id")

  user AuthServiceUser @relation(fields: [userId], references: [id])
  role AuthServiceRole @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@index([roleId])
  @@map("auth_service_users_roles")
}

model AuthServiceRolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       AuthServiceRole       @relation(fields: [roleId], references: [id])
  permission AuthServicePermission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("auth_service_roles_permissions")
}
